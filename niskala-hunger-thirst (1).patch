+## DEC-008 — Hunger/Thirsty berkurang berdasarkan durasi BERJALAN (menyimpang dari GDD)
+- Tanggal: 2026-10-19
+- Konteks / masalah: GDD v1.0 menetapkan Hunger -1/8 dtk dan Thirsty -1/6 dtk berbasis waktu. Pemilik proyek meminta pengurangan hanya saat pemain berjalan, Thirsty lebih cepat dari Hunger, dan HP berkurang cepat jika keduanya kosong.
+- Keputusan: Instruksi terbaru pemilik menang (CLAUDE.md bagian 2). Angka GDD (8 dan 6 detik) dipakai sebagai "detik berjalan per poin". Deteksi jalan di server dari perpindahan horizontal HumanoidRootPart. HP berkurang saat Hunger DAN Thirsty = 0 (GDD: cukup Hunger = 0). Damage 2 HP / 2 dtk (nilai baru, bisa diubah di `GameConfig.Survival`).
+- Alternatif yang ditolak: Berbasis waktu murni (sesuai GDD, bukan permintaan); membaca `Humanoid.MoveDirection` (lebih mudah dimanipulasi client).
+- Dampak: GDD perlu diselaraskan oleh pemilik. Efek lambat Thirsty 0 (60%), regen HP, dan respawn di Pelabuhan BELUM dikerjakan (bagian Phase 2 lain).
+
+## DEC-009 — Durasi kosong Hunger/Thirsty 6:30; HUD kiri atas tanpa angka
+- Tanggal: 2026-10-19
+- Konteks / masalah: Pemilik meminta bar kosong dalam 6 menit 30 detik dan Thirsty turun lebih signifikan dari Hunger. Permintaan tidak merinci apakah 6:30 itu waktu berjalan dan apakah kedua bar kosong bersamaan.
+- Keputusan: 6:30 = detik BERJALAN (konsisten dengan DEC-008). Hunger kosong pada 390 dtk (3.9 dtk/poin), Thirsty pada 260 dtk (2.6 dtk/poin, 1.5x lebih cepat). Keadaan "keduanya kosong" (HP mulai turun) tercapai pada 6:30. Menggantikan angka 8 dan 6 dari DEC-008.
+- Alternatif yang ditolak: Kedua bar kosong tepat pada 6:30 dengan laju sama (bertentangan dengan "thirst lebih cepat").
+- Dampak: Angka di `GameConfig.Survival`. HUD: bar LAPAR, HAUS, HP di kiri atas tanpa nominal.
+
+## DEC-010 — Konsep baru: bar habis 3:00 (Hunger) dan 1:30 (Thirsty); HP bar tengah bawah
+- Tanggal: 2026-10-19
+- Konteks / masalah: Pemilik mengubah konsep: "hunger berkurang 1 selama 3 menit, thirst 1 menit 30 detik". Frasa ini ambigu (1 poin dari 100? atau 1 bar penuh?).
+- Keputusan: Dibaca sebagai 1 bar penuh habis dalam 3:00 (Hunger) dan 1:30 (Thirsty): 1.8 dan 0.9 dtk/poin. Menggantikan DEC-009. Tambah `DrainOnlyWhileWalking` (default true) agar mode berbasis waktu bisa dipilih tanpa ubah kode. HP bar tengah bawah: hijau, oranye saat HP <= 50, merah saat HP <= 25 (nilai di config).
+- Alternatif yang ditolak: 1 poin per 3 menit (bar penuh habis 5 jam, tidak masuk akal untuk gameplay).
+- Dampak: Menyimpang jauh dari GDD (8 dtk/6 dtk per poin); GDD perlu diselaraskan. Starvation (kedua bar 0) dimulai pada 3:00.
diff --git a/src/client/Stats/StatsHud.client.lua b/src/client/Stats/StatsHud.client.lua
new file mode 100644
index 0000000..8fcd2a5
--- /dev/null
+++ b/src/client/Stats/StatsHud.client.lua
@@ -0,0 +1,171 @@
+--!strict
+-- StatsHud: HUD survival (hanya presentasi).
+--   * Bar LAPAR dan HAUS di kiri atas, tanpa angka. Nilai dibaca dari Attribute
+--     "Hunger"/"Thirsty" pada LocalPlayer (diisi server oleh PlayerStats).
+--   * Bar HP di tengah bawah layar (di antara analog dan tombol lompat pada mobile).
+--     Hijau; oranye saat HP <= HpOrangeAtOrBelow; merah saat HP <= HpRedAtOrBelow.
+--     Nilai dibaca dari Humanoid karakter saat ini.
+-- Tidak menyimpan state sendiri.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local TweenService = game:GetService("TweenService")
+
+local localPlayer = Players.LocalPlayer
+local playerGui = localPlayer:WaitForChild("PlayerGui")
+
+local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig") :: ModuleScript) :: any
+local SURVIVAL = GameConfig.Survival
+local MAX_STAT: number = SURVIVAL.MaxStat
+
+local COLOR_PANEL = Color3.fromRGB(22, 26, 32)
+local COLOR_GREEN = Color3.fromRGB(80, 190, 90)
+local COLOR_ORANGE = Color3.fromRGB(240, 150, 40)
+local COLOR_RED = Color3.fromRGB(220, 60, 60)
+local LOW_FRACTION = 0.2 -- Hunger/Thirsty menjadi merah di bawah 20%
+
+local function create(className: string, props: { [string]: any }, parent: Instance?): any
+	local instance = Instance.new(className)
+	for key, value in props do
+		(instance :: any)[key] = value
+	end
+	instance.Parent = parent
+	return instance
+end
+
+local gui = create("ScreenGui", {
+	Name = "StatsHudGui",
+	ResetOnSpawn = false,
+	DisplayOrder = 5, -- di bawah dialog (20)
+	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
+}, playerGui)
+
+-- Satu bar: panel gelap + isi yang dianimasikan. Tanpa angka.
+local function createBar(name: string, label: string, color: Color3, size: UDim2, parent: Instance): any
+	local row = create("Frame", {
+		Name = name,
+		Size = size,
+		BackgroundColor3 = COLOR_PANEL,
+		BackgroundTransparency = 0.25,
+		BorderSizePixel = 0,
+	}, parent)
+	create("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
+
+	local fill = create("Frame", {
+		Name = "Fill",
+		Size = UDim2.new(1, 0, 1, 0),
+		BackgroundColor3 = color,
+		BorderSizePixel = 0,
+	}, row)
+	create("UICorner", { CornerRadius = UDim.new(0, 6) }, fill)
+
+	create("TextLabel", {
+		Name = "Label",
+		Position = UDim2.new(0, 8, 0, 0),
+		Size = UDim2.new(1, -16, 1, 0),
+		BackgroundTransparency = 1,
+		Font = Enum.Font.GothamBold,
+		TextSize = 13,
+		TextColor3 = Color3.new(1, 1, 1),
+		TextStrokeTransparency = 0.5,
+		TextXAlignment = Enum.TextXAlignment.Left,
+		Text = label,
+		ZIndex = 2,
+	}, row)
+
+	return { row = row, fill = fill, color = color }
+end
+
+local function setBar(bar: any, fraction: number, color: Color3)
+	TweenService:Create(bar.fill, TweenInfo.new(0.25), {
+		Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0),
+		BackgroundColor3 = color,
+	}):Play()
+end
+
+------------------------------------------------------------------------
+-- LAPAR dan HAUS: kiri atas
+------------------------------------------------------------------------
+
+local topLeft = create("Frame", {
+	Name = "TopLeft",
+	Position = UDim2.new(0, 12, 0, 12), -- geser di sini jika bertabrakan dengan UI lain
+	Size = UDim2.new(0, 200, 0, 52),
+	BackgroundTransparency = 1,
+}, gui)
+create("UIListLayout", {
+	FillDirection = Enum.FillDirection.Vertical,
+	Padding = UDim.new(0, 6),
+	SortOrder = Enum.SortOrder.LayoutOrder,
+}, topLeft)
+
+local bars = {
+	Hunger = createBar("HungerBar", "LAPAR", Color3.fromRGB(230, 150, 40), UDim2.new(1, 0, 0, 23), topLeft),
+	Thirsty = createBar("ThirstyBar", "HAUS", Color3.fromRGB(60, 150, 230), UDim2.new(1, 0, 0, 23), topLeft),
+}
+bars.Hunger.row.LayoutOrder = 1
+bars.Thirsty.row.LayoutOrder = 2
+
+local function refreshStat(attributeName: string)
+	local bar = bars[attributeName]
+	local raw = localPlayer:GetAttribute(attributeName)
+	local amount = if type(raw) == "number" then raw else MAX_STAT
+	local fraction = amount / MAX_STAT
+	setBar(bar, fraction, if fraction <= LOW_FRACTION then COLOR_RED else bar.color)
+end
+
+for attributeName in bars do
+	refreshStat(attributeName)
+	localPlayer:GetAttributeChangedSignal(attributeName):Connect(function()
+		refreshStat(attributeName)
+	end)
+end
+
+------------------------------------------------------------------------
+-- HP: tengah bawah (antara analog kiri dan tombol lompat kanan pada mobile)
+------------------------------------------------------------------------
+
+local hpHolder = create("Frame", {
+	Name = "HpHolder",
+	AnchorPoint = Vector2.new(0.5, 1),
+	Position = UDim2.new(0.5, 0, 1, -16),
+	Size = UDim2.new(0.28, 0, 0, 22),
+	BackgroundTransparency = 1,
+}, gui)
+create("UISizeConstraint", { MinSize = Vector2.new(120, 22), MaxSize = Vector2.new(260, 22) }, hpHolder)
+
+local hpBar = createBar("HpBar", "HP", COLOR_GREEN, UDim2.new(1, 0, 1, 0), hpHolder)
+
+local function hpColor(health: number): Color3
+	if health <= SURVIVAL.HpRedAtOrBelow then
+		return COLOR_RED
+	elseif health <= SURVIVAL.HpOrangeAtOrBelow then
+		return COLOR_ORANGE
+	end
+	return COLOR_GREEN
+end
+
+local humanoidConns: { RBXScriptConnection } = {}
+
+local function bindHumanoid(character: Model)
+	for _, conn in humanoidConns do
+		conn:Disconnect()
+	end
+	table.clear(humanoidConns)
+
+	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
+	if not humanoid then
+		return
+	end
+	local function update()
+		setBar(hpBar, humanoid.Health / math.max(humanoid.MaxHealth, 1), hpColor(humanoid.Health))
+	end
+	update()
+	table.insert(humanoidConns, humanoid.HealthChanged:Connect(update))
+	table.insert(humanoidConns, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update))
+end
+
+localPlayer.CharacterAdded:Connect(bindHumanoid)
+if localPlayer.Character then
+	task.spawn(bindHumanoid, localPlayer.Character)
+end
diff --git a/src/server/Stats/PlayerStats.lua b/src/server/Stats/PlayerStats.lua
new file mode 100644
index 0000000..f226296
--- /dev/null
+++ b/src/server/Stats/PlayerStats.lua
@@ -0,0 +1,229 @@
+--!strict
+-- PlayerStats: pemilik state Hunger/Thirsty per pemain (server = sumber kebenaran).
+--
+-- Perilaku:
+--   * Hunger dan Thirsty berkurang (default: hanya saat pemain benar-benar bergerak,
+--     diukur server dari perpindahan HumanoidRootPart; atur DrainOnlyWhileWalking).
+--   * Thirsty turun lebih cepat daripada Hunger (lihat GameConfig.Survival).
+--   * Jika Hunger DAN Thirsty kosong, HP berkurang berkala.
+--   * Setelah mati, nilai di-set ke RespawnHunger/RespawnThirsty saat karakter muncul lagi.
+--
+-- State dicerminkan ke Attribute Player ("Hunger", "Thirsty") agar HUD client bisa
+-- membaca tanpa Remote. Client tidak bisa mengubah state server lewat Attribute.
+--
+-- BUKAN tanggung jawab modul ini: koin, shop, regen HP, efek lambat Thirsty 0.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local SurvivalLogic = require(script.Parent.SurvivalLogic)
+
+local sharedFolder = ReplicatedStorage:WaitForChild("Shared", 5)
+assert(sharedFolder, "[PlayerStats] ReplicatedStorage.Shared tidak ditemukan.")
+local configModule = sharedFolder:WaitForChild("GameConfig", 5)
+assert(configModule, "[PlayerStats] ReplicatedStorage.Shared.GameConfig tidak ditemukan.")
+local GameConfig = require(configModule :: ModuleScript) :: any
+local CFG = GameConfig.Survival
+
+type PlayerData = {
+	state: SurvivalLogic.State,
+	lastPos: Vector3?,
+	respawnReset: boolean,
+	characterConn: RBXScriptConnection?,
+	diedConn: RBXScriptConnection?,
+	shownHunger: number,
+	shownThirst: number,
+}
+
+local PlayerStats = {}
+
+local dataByPlayer: { [Player]: PlayerData } = {}
+local connections: { RBXScriptConnection } = {}
+local started = false
+
+local function publish(player: Player, data: PlayerData)
+	local hunger = SurvivalLogic.Display(data.state.hunger)
+	local thirst = SurvivalLogic.Display(data.state.thirst)
+	-- SetAttribute hanya dipanggil bila nilai tampilan berubah (hemat replikasi).
+	if hunger ~= data.shownHunger then
+		data.shownHunger = hunger
+		player:SetAttribute("Hunger", hunger)
+	end
+	if thirst ~= data.shownThirst then
+		data.shownThirst = thirst
+		player:SetAttribute("Thirsty", thirst)
+	end
+end
+
+local function getHumanoid(player: Player): Humanoid?
+	local character = player.Character
+	if not character then
+		return nil
+	end
+	return character:FindFirstChildOfClass("Humanoid")
+end
+
+local function onCharacterAdded(player: Player, character: Model)
+	local data = dataByPlayer[player]
+	if not data then
+		return
+	end
+
+	data.lastPos = nil
+	if data.diedConn then
+		data.diedConn:Disconnect()
+		data.diedConn = nil
+	end
+
+	if data.respawnReset then
+		data.respawnReset = false
+		data.state = SurvivalLogic.NewState(CFG.RespawnHunger, CFG.RespawnThirsty)
+		publish(player, data)
+	end
+
+	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
+	if humanoid and dataByPlayer[player] == data then
+		data.diedConn = humanoid.Died:Connect(function()
+			data.respawnReset = true
+		end)
+	end
+end
+
+local function addPlayer(player: Player)
+	if dataByPlayer[player] then
+		return
+	end
+
+	local data: PlayerData = {
+		state = SurvivalLogic.NewState(CFG.StartHunger, CFG.StartThirsty),
+		lastPos = nil,
+		respawnReset = false,
+		characterConn = nil,
+		diedConn = nil,
+		shownHunger = -1,
+		shownThirst = -1,
+	}
+	dataByPlayer[player] = data
+	publish(player, data)
+
+	data.characterConn = player.CharacterAdded:Connect(function(character)
+		onCharacterAdded(player, character)
+	end)
+	if player.Character then
+		task.spawn(onCharacterAdded, player, player.Character)
+	end
+end
+
+local function removePlayer(player: Player)
+	local data = dataByPlayer[player]
+	if not data then
+		return
+	end
+	if data.characterConn then
+		data.characterConn:Disconnect()
+	end
+	if data.diedConn then
+		data.diedConn:Disconnect()
+	end
+	dataByPlayer[player] = nil
+end
+
+-- Apakah pemain sedang berjalan? Diukur dari kecepatan horizontal nyata.
+local function isWalking(data: PlayerData, humanoid: Humanoid, dt: number): boolean
+	local root = humanoid.RootPart
+	if not root then
+		data.lastPos = nil
+		return false
+	end
+
+	local pos = root.Position
+	local last = data.lastPos
+	data.lastPos = pos
+	if not last or dt <= 0 then
+		return false
+	end
+
+	local delta = pos - last
+	local horizontalSpeed = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
+	return horizontalSpeed >= CFG.MinWalkSpeed and horizontalSpeed <= CFG.TeleportSpeedLimit
+end
+
+local function tick(dt: number)
+	for player, data in dataByPlayer do
+		local humanoid = getHumanoid(player)
+		if not humanoid or humanoid.Health <= 0 then
+			data.lastPos = nil
+			continue
+		end
+
+		local walking = isWalking(data, humanoid, dt)
+		local draining = walking or not CFG.DrainOnlyWhileWalking
+		local damage = SurvivalLogic.Step(data.state, dt, draining, CFG)
+		publish(player, data)
+
+		if damage > 0 and humanoid.Health > 0 then
+			-- Set langsung (bukan TakeDamage) agar tidak diblok ForceField spawn.
+			humanoid.Health = math.max(0, humanoid.Health - damage)
+		end
+	end
+end
+
+------------------------------------------------------------------------
+-- API publik (server saja; dipakai Shop/Quest di phase berikutnya)
+------------------------------------------------------------------------
+
+-- Mengembalikan (hunger, thirsty) sebagai bilangan bulat, atau nil jika pemain tidak dikenal.
+function PlayerStats.Get(player: Player): (number?, number?)
+	local data = dataByPlayer[player]
+	if not data then
+		return nil, nil
+	end
+	return SurvivalLogic.Display(data.state.hunger), SurvivalLogic.Display(data.state.thirst)
+end
+
+-- Menambah/mengurangi status. stat = "Hunger" | "Thirsty". Hasil di-clamp 0..MaxStat.
+function PlayerStats.Add(player: Player, stat: string, amount: number): boolean
+	local data = dataByPlayer[player]
+	if not data or type(amount) ~= "number" or amount ~= amount then
+		return false
+	end
+	if stat == "Hunger" then
+		data.state.hunger = SurvivalLogic.Clamp(data.state.hunger + amount, CFG.MaxStat)
+	elseif stat == "Thirsty" then
+		data.state.thirst = SurvivalLogic.Clamp(data.state.thirst + amount, CFG.MaxStat)
+	else
+		warn("[PlayerStats] Stat tidak dikenal: " .. tostring(stat))
+		return false
+	end
+	publish(player, data)
+	return true
+end
+
+function PlayerStats.Start()
+	if started then
+		return
+	end
+	started = true
+
+	table.insert(connections, Players.PlayerAdded:Connect(addPlayer))
+	table.insert(connections, Players.PlayerRemoving:Connect(removePlayer))
+	for _, player in Players:GetPlayers() do
+		addPlayer(player)
+	end
+
+	task.spawn(function()
+		local last = os.clock()
+		while started do
+			task.wait(CFG.TickInterval)
+			local now = os.clock()
+			local dt = now - last
+			last = now
+			local ok, err = pcall(tick, dt)
+			if not ok then
+				warn("[PlayerStats] Error pada tick: " .. tostring(err))
+			end
+		end
+	end)
+end
+
+return PlayerStats
