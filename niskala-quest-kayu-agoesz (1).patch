diff --git a/src/server/Quest/QuestService.lua b/src/server/Quest/QuestService.lua
new file mode 100644
index 0000000..fbaa6bb
--- /dev/null
+++ b/src/server/Quest/QuestService.lua
@@ -0,0 +1,174 @@
+--!strict
+-- QuestService: pemilik tunggal STATE quest per pemain (server = sumber kebenaran).
+--
+-- State: NotStarted -> Active -> ReadyToTurnIn -> Completed (hanya sekali).
+-- Modul ini tidak tahu apa pun tentang objek Workspace; logika spesifik quest
+-- (mis. titik kayu) ada di modul terpisah yang memakai API ini.
+--
+-- Hadiah (Koin + Kepercayaan) hanya diberikan di TurnIn, tepat satu kali.
+-- STATUS: state hanya di memori server (belum disimpan -> Phase 8). State melekat pada
+-- Player, bukan karakter, jadi respawn tidak menghapus progres.
+-- Cermin ke Attribute Player: "Quest_<id>_State" dan "Quest_<id>_Progress".
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local CurrencyService = require(script.Parent.Parent.Economy.CurrencyService)
+local TrustService = require(script.Parent.Parent.Trust.TrustService)
+
+local sharedFolder = ReplicatedStorage:WaitForChild("Shared", 5)
+assert(sharedFolder, "[Quest] ReplicatedStorage.Shared tidak ditemukan.")
+local configModule = sharedFolder:WaitForChild("GameConfig", 5)
+assert(configModule, "[Quest] ReplicatedStorage.Shared.GameConfig tidak ditemukan.")
+local GameConfig = require(configModule :: ModuleScript) :: any
+
+export type State = "NotStarted" | "Active" | "ReadyToTurnIn" | "Completed"
+
+type QuestData = { state: State, progress: number }
+type Listener = (player: Player, questId: string, state: State, progress: number) -> ()
+
+local QuestService = {}
+
+local dataByPlayer: { [Player]: { [string]: QuestData } } = {}
+local listeners: { Listener } = {}
+local unavailable: { [string]: boolean } = {}
+
+local function getDef(questId: string): any?
+	local def = GameConfig.Quests[questId]
+	if not def then
+		warn(("[Quest] Quest '%s' tidak ada di GameConfig.Quests"):format(questId))
+	end
+	return def
+end
+
+local function getData(player: Player, questId: string): QuestData?
+	local quests = dataByPlayer[player]
+	if not quests then
+		return nil
+	end
+	local data = quests[questId]
+	if not data then
+		data = { state = "NotStarted", progress = 0 }
+		quests[questId] = data
+	end
+	return data
+end
+
+local function publish(player: Player, questId: string, data: QuestData)
+	player:SetAttribute(("Quest_%s_State"):format(questId), data.state)
+	player:SetAttribute(("Quest_%s_Progress"):format(questId), data.progress)
+end
+
+local function notify(player: Player, questId: string, data: QuestData)
+	publish(player, questId, data)
+	for _, listener in listeners do
+		local ok, err = pcall(listener, player, questId, data.state, data.progress)
+		if not ok then
+			warn(("[Quest] Listener error (%s): %s"):format(questId, tostring(err)))
+		end
+	end
+end
+
+function QuestService.GetState(player: Player, questId: string): State
+	local data = getData(player, questId)
+	return if data then data.state else "NotStarted"
+end
+
+function QuestService.GetProgress(player: Player, questId: string): number
+	local data = getData(player, questId)
+	return if data then data.progress else 0
+end
+
+-- Dipanggil modul quest saat state/progres berubah. Listener berjalan di server.
+function QuestService.Subscribe(listener: Listener)
+	table.insert(listeners, listener)
+end
+
+-- Modul quest menandai quest tidak bisa dijalankan (mis. objek Workspace tidak ditemukan)
+-- agar pemain tidak terjebak di quest yang mustahil diselesaikan.
+function QuestService.SetAvailable(questId: string, available: boolean)
+	unavailable[questId] = if available then nil else true
+end
+
+function QuestService.IsAvailable(questId: string): boolean
+	return unavailable[questId] ~= true
+end
+
+-- NotStarted -> Active. Gagal jika quest sudah pernah dimulai/selesai.
+function QuestService.Start(player: Player, questId: string): boolean
+	if not getDef(questId) or unavailable[questId] then
+		return false
+	end
+	local data = getData(player, questId)
+	if not data or data.state ~= "NotStarted" then
+		return false
+	end
+	data.state = "Active"
+	data.progress = 0
+	notify(player, questId, data)
+	return true
+end
+
+-- Menambah progres quest yang sedang Active. Mengembalikan progres baru, atau nil jika ditolak.
+-- Mencapai target -> state menjadi ReadyToTurnIn (hadiah BELUM diberikan).
+function QuestService.AddProgress(player: Player, questId: string, amount: number): number?
+	local def = getDef(questId)
+	local data = getData(player, questId)
+	if not def or not data or data.state ~= "Active" then
+		return nil
+	end
+	if type(amount) ~= "number" or amount ~= amount or amount < 1 or amount ~= math.floor(amount) then
+		return nil
+	end
+	data.progress = math.min(def.target, data.progress + amount)
+	if data.progress >= def.target then
+		data.state = "ReadyToTurnIn"
+	end
+	notify(player, questId, data)
+	return data.progress
+end
+
+-- ReadyToTurnIn -> Completed + hadiah. State diubah SEBELUM hadiah diberikan agar
+-- pemanggilan ganda tidak bisa memberi hadiah dua kali.
+function QuestService.TurnIn(player: Player, questId: string): boolean
+	local def = getDef(questId)
+	local data = getData(player, questId)
+	if not def or not data or data.state ~= "ReadyToTurnIn" then
+		return false
+	end
+	data.state = "Completed"
+	if not CurrencyService.Add(player, def.rewardCoins) then
+		warn(("[Quest] Gagal memberi %d Koin untuk quest '%s' (%s)"):format(def.rewardCoins, questId, player.Name))
+	end
+	if not TrustService.Add(player, def.rewardTrust) then
+		warn(("[Quest] Gagal memberi %d kepercayaan untuk quest '%s' (%s)"):format(def.rewardTrust, questId, player.Name))
+	end
+	notify(player, questId, data)
+	return true
+end
+
+local started = false
+
+function QuestService.Init()
+	if started then
+		return
+	end
+	started = true
+	CurrencyService.Start()
+	TrustService.Start()
+	Players.PlayerAdded:Connect(function(player: Player)
+		if not dataByPlayer[player] then
+			dataByPlayer[player] = {}
+		end
+	end)
+	Players.PlayerRemoving:Connect(function(player: Player)
+		dataByPlayer[player] = nil
+	end)
+	for _, player in Players:GetPlayers() do
+		if not dataByPlayer[player] then
+			dataByPlayer[player] = {}
+		end
+	end
+end
+
+return QuestService
diff --git a/src/server/Quest/WoodQuest.lua b/src/server/Quest/WoodQuest.lua
new file mode 100644
index 0000000..d7da5dc
--- /dev/null
+++ b/src/server/Quest/WoodQuest.lua
@@ -0,0 +1,240 @@
+--!strict
+-- WoodQuest: logika quest Kayu (Hutan). Memakai titik kayu yang SUDAH ADA di Workspace.
+--
+--   * Saat quest dimulai, dipilih tepat `target` titik BERBEDA secara acak dari semua titik.
+--   * Kayu hanya dihitung jika pemain benar-benar berhasil mengambilnya (divalidasi server:
+--     state quest, titik termasuk yang terpilih untuk pemain itu, belum diambil, jarak).
+--   * Menyerahkan kayu ke Agoesz dilakukan lewat dialog (QuestService.TurnIn).
+--
+-- Tidak ada Part/model yang dibuat atau dipindah. Jika sebuah titik belum punya
+-- ProximityPrompt, dibuat satu objek logika nonvisual "KayuPrompt". Visibilitas titik
+-- per pemain diatur di sisi client (QuestClient) lewat remote Sync.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Workspace = game:GetService("Workspace")
+
+local QuestService = require(script.Parent.QuestService)
+
+local sharedFolder = ReplicatedStorage:WaitForChild("Shared", 5)
+assert(sharedFolder, "[WoodQuest] ReplicatedStorage.Shared tidak ditemukan.")
+local configModule = sharedFolder:WaitForChild("GameConfig", 5)
+assert(configModule, "[WoodQuest] ReplicatedStorage.Shared.GameConfig tidak ditemukan.")
+local GameConfig = require(configModule :: ModuleScript) :: any
+
+local QUEST_ID = "Wood"
+local CFG = GameConfig.Quests.Wood
+local DISTANCE_PADDING = 8 -- toleransi jarak validasi server di atas MaxActivationDistance
+
+local WoodQuest = {}
+
+local points: { Instance } = {}
+-- Titik yang MASIH bisa diambil, per pemain.
+local remainingByPlayer: { [Player]: { [Instance]: boolean } } = {}
+local rng = Random.new()
+local started = false
+
+local syncRemote: RemoteEvent
+local notifyRemote: RemoteEvent
+local requestSyncRemote: RemoteEvent
+
+local function getOrCreateRemote(folder: Folder, name: string): RemoteEvent
+	local existing = folder:FindFirstChild(name)
+	if existing and existing:IsA("RemoteEvent") then
+		return existing
+	end
+	local remote = Instance.new("RemoteEvent")
+	remote.Name = name
+	remote.Parent = folder
+	return remote
+end
+
+local function getPointPart(point: Instance): BasePart?
+	if point:IsA("BasePart") then
+		return point
+	end
+	if point:IsA("Model") then
+		return point.PrimaryPart or point:FindFirstChildWhichIsA("BasePart", true)
+	end
+	return nil
+end
+
+local function findContainer(name: string): Instance?
+	local found: Instance? = nil
+	local count = 0
+	for _, instance in Workspace:GetDescendants() do
+		if instance.Name == name and (instance:IsA("Folder") or instance:IsA("Model")) then
+			count += 1
+			if not found then
+				found = instance
+			end
+		end
+	end
+	if count > 1 then
+		warn(("[WoodQuest] Ada %d objek bernama '%s'. Memakai yang pertama ditemukan."):format(count, name))
+	end
+	return found
+end
+
+-- Kirim ke client: semua titik kayu + titik yang saat ini aktif untuk pemain ini.
+local function sendSync(player: Player)
+	local active: { Instance } = {}
+	local remaining = remainingByPlayer[player]
+	if remaining then
+		for point in remaining do
+			table.insert(active, point)
+		end
+	end
+	syncRemote:FireClient(player, {
+		hideInactive = CFG.hideInactive,
+		points = points,
+		active = active,
+	})
+end
+
+local function notifyPlayer(player: Player, text: string)
+	notifyRemote:FireClient(player, text)
+end
+
+local function pickPoints(player: Player)
+	-- Fisher-Yates pada salinan, ambil `target` titik pertama => tidak ada duplikasi.
+	local pool = table.clone(points)
+	for i = #pool, 2, -1 do
+		local j = rng:NextInteger(1, i)
+		pool[i], pool[j] = pool[j], pool[i]
+	end
+	local chosen: { [Instance]: boolean } = {}
+	for i = 1, math.min(CFG.target, #pool) do
+		chosen[pool[i]] = true
+	end
+	remainingByPlayer[player] = chosen
+end
+
+local function onPickup(player: Player, point: Instance, prompt: ProximityPrompt, part: BasePart)
+	local remaining = remainingByPlayer[player]
+	if not remaining or not remaining[point] then
+		return -- bukan titik terpilih untuk pemain ini, atau sudah diambil
+	end
+	if QuestService.GetState(player, QUEST_ID) ~= "Active" then
+		return
+	end
+	local character = player.Character
+	local root = character and character:FindFirstChild("HumanoidRootPart")
+	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
+	if not (root and root:IsA("BasePart")) or not humanoid or humanoid.Health <= 0 then
+		return
+	end
+	if (root.Position - part.Position).Magnitude > prompt.MaxActivationDistance + DISTANCE_PADDING then
+		return
+	end
+
+	remaining[point] = nil -- tandai SEBELUM menambah progres agar tidak bisa dihitung dua kali
+	local progress = QuestService.AddProgress(player, QUEST_ID, 1)
+	if progress == nil then
+		remaining[point] = true -- progres ditolak: kembalikan titik
+		return
+	end
+	sendSync(player)
+	if progress >= CFG.target then
+		notifyPlayer(player, ("Kayu terkumpul %d/%d. Antarkan ke Agoesz di desa!"):format(progress, CFG.target))
+	else
+		notifyPlayer(player, ("Kayu %d/%d"):format(progress, CFG.target))
+	end
+end
+
+local function bindPoint(point: Instance)
+	local part = getPointPart(point)
+	if not part then
+		warn(("[WoodQuest] Titik '%s' tidak punya BasePart. Dilewati."):format(point:GetFullName()))
+		return
+	end
+
+	local prompt = point:FindFirstChildWhichIsA("ProximityPrompt", true)
+	if not prompt then
+		local newPrompt = Instance.new("ProximityPrompt")
+		newPrompt.Name = "KayuPrompt"
+		newPrompt.ActionText = "Ambil"
+		newPrompt.ObjectText = "Kayu"
+		newPrompt.HoldDuration = 0
+		newPrompt.MaxActivationDistance = CFG.promptDistance
+		newPrompt.RequiresLineOfSight = false
+		newPrompt.KeyboardKeyCode = Enum.KeyCode.E
+		newPrompt.Parent = part
+		prompt = newPrompt
+	end
+	local bound = prompt :: ProximityPrompt
+	bound.Triggered:Connect(function(player: Player)
+		onPickup(player, point, bound, part)
+	end)
+end
+
+function WoodQuest.Start()
+	if started then
+		return
+	end
+	started = true
+
+	QuestService.Init()
+
+	local folder = ReplicatedStorage:FindFirstChild("QuestRemotes")
+	if not folder then
+		local newFolder = Instance.new("Folder")
+		newFolder.Name = "QuestRemotes"
+		newFolder.Parent = ReplicatedStorage
+		folder = newFolder
+	end
+	local remoteFolder = folder :: Folder
+	syncRemote = getOrCreateRemote(remoteFolder, "Sync") -- server -> client
+	notifyRemote = getOrCreateRemote(remoteFolder, "Notify") -- server -> client
+	requestSyncRemote = getOrCreateRemote(remoteFolder, "RequestSync") -- client -> server
+
+	QuestService.SetAvailable(QUEST_ID, false) -- aktif lagi hanya jika semua titik valid
+	local container = findContainer(CFG.spawnContainerName)
+	if not container then
+		warn(("[WoodQuest] Folder/Model titik kayu '%s' tidak ditemukan di Workspace. Quest Kayu tidak aktif. Sesuaikan GameConfig.Quests.Wood.spawnContainerName dengan nama di Explorer."):format(CFG.spawnContainerName))
+		return
+	end
+	for _, child in container:GetChildren() do
+		if child:IsA("BasePart") or child:IsA("Model") then
+			table.insert(points, child)
+		end
+	end
+	print(("[WoodQuest] %d titik kayu ditemukan di %s"):format(#points, container:GetFullName()))
+	if #points ~= CFG.spawnCount then
+		warn(("[WoodQuest] Jumlah titik kayu %d, GDD/konfigurasi mengharapkan %d."):format(#points, CFG.spawnCount))
+	end
+	if #points < CFG.target then
+		warn(("[WoodQuest] Titik kayu (%d) kurang dari target (%d). Quest Kayu tidak aktif."):format(#points, CFG.target))
+		points = {}
+		return
+	end
+	for _, point in points do
+		bindPoint(point)
+	end
+	QuestService.SetAvailable(QUEST_ID, true)
+
+	QuestService.Subscribe(function(player: Player, questId: string, state: QuestService.State, progress: number)
+		if questId ~= QUEST_ID then
+			return
+		end
+		if state == "Active" and progress == 0 then
+			pickPoints(player)
+		elseif state == "ReadyToTurnIn" or state == "Completed" then
+			remainingByPlayer[player] = {}
+		end
+		sendSync(player)
+		if state == "Completed" then
+			notifyPlayer(player, ("Quest selesai! +%d Koin, +%d kepercayaan warga"):format(CFG.rewardCoins, CFG.rewardTrust))
+		end
+	end)
+
+	requestSyncRemote.OnServerEvent:Connect(function(player: Player)
+		sendSync(player)
+	end)
+
+	Players.PlayerRemoving:Connect(function(player: Player)
+		remainingByPlayer[player] = nil
+	end)
+end
+
+return WoodQuest
diff --git a/src/server/Trust/TrustService.lua b/src/server/Trust/TrustService.lua
new file mode 100644
index 0000000..cc86cce
--- /dev/null
+++ b/src/server/Trust/TrustService.lua
@@ -0,0 +1,59 @@
+--!strict
+-- TrustService: pemilik tunggal Kepercayaan Warga per pemain (0-100). Server = sumber kebenaran.
+--
+-- Kepercayaan HANYA bertambah lewat penyelesaian quest (QuestService.TurnIn memanggil Add).
+-- STATUS: nilai hanya di memori server (belum disimpan -> Phase 8). Belum terhubung ke
+-- Gerbang Candi (itu tugas terpisah di Phase 3).
+-- Nilai dicerminkan ke Attribute Player "Trust" agar UI bisa membaca tanpa Remote.
+
+local Players = game:GetService("Players")
+
+local MAX_TRUST = 100 -- GDD: rentang 0-100
+
+local TrustService = {}
+
+local trustByPlayer: { [Player]: number } = {}
+local started = false
+
+local function publish(player: Player)
+	player:SetAttribute("Trust", trustByPlayer[player])
+end
+
+local function addPlayer(player: Player)
+	if trustByPlayer[player] ~= nil then
+		return
+	end
+	trustByPlayer[player] = 0
+	publish(player)
+end
+
+function TrustService.Get(player: Player): number?
+	return trustByPlayer[player]
+end
+
+-- Menambah kepercayaan (bilangan bulat positif). Hasil dijepit ke 0..100.
+function TrustService.Add(player: Player, amount: number): boolean
+	local current = trustByPlayer[player]
+	if current == nil or type(amount) ~= "number" or amount ~= amount or amount <= 0 or amount ~= math.floor(amount) then
+		return false
+	end
+	trustByPlayer[player] = math.min(MAX_TRUST, current + amount)
+	publish(player)
+	return true
+end
+
+function TrustService.Start()
+	if started then
+		return
+	end
+	started = true
+	Players.PlayerAdded:Connect(addPlayer)
+	Players.PlayerRemoving:Connect(function(player: Player)
+		trustByPlayer[player] = nil
+	end)
+	for _, player in Players:GetPlayers() do
+		addPlayer(player)
+	end
+end
+
+return TrustService
